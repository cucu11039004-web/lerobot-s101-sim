<!--
  Push 场景: 方块+目标固定 + 手腕相机 + workspace 可视化

  工作区: x∈[0.17, 0.30], y∈[-0.10, 0.08]
          中心 (0.235, -0.01), 半尺寸 (0.065, 0.09)

  cube:   3cm 立方体 (freejoint "cube_free")
  target: 固定body (绿色圆盘, 固定在工作区前方)
  ws_edge_*: 黄色矩形边框, 标示随机范围
  top_cam:  俯视全景相机 (用于验证视野)

  运行: mjpython push_demo_random.py
-->
<mujoco model="so_arm100_push_scene">
  <include file="./assets_so100/so_arm100_local.xml"/>

  <statistic center="0.235 -0.01 0.08" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Workspace 边框 (黄色, 不参与碰撞) -->
    <geom name="ws_edge_1" type="box" pos="0.17  -0.01 0.001" size="0.002 0.09 0.001"
          rgba="1 0.85 0 0.8" contype="0" conaffinity="0"/>
    <geom name="ws_edge_2" type="box" pos="0.30  -0.01 0.001" size="0.002 0.09 0.001"
          rgba="1 0.85 0 0.8" contype="0" conaffinity="0"/>
    <geom name="ws_edge_3" type="box" pos="0.235 -0.10 0.001" size="0.065 0.002 0.001"
          rgba="1 0.85 0 0.8" contype="0" conaffinity="0"/>
    <geom name="ws_edge_4" type="box" pos="0.235  0.08 0.001" size="0.065 0.002 0.001"
          rgba="1 0.85 0 0.8" contype="0" conaffinity="0"/>

    <!-- 顶部俯视相机 (固定在 workspace 正上方, 验证视野用) -->
    <camera name="top_cam" pos="0.235 -0.01 0.45"
            xyaxes="1 0 0  0 1 0"/>

    <!-- cube -->
    <body name="cube" pos="0.14 0.00 0.015">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015"
            rgba="0.8 0.2 0.2 1"
            mass="0.05"
            friction="1.0 0.005 0.0001"/>
    </body>

    <!-- target (固定位置，在工作区内靠近边缘) -->
    <body name="target" pos="0.29 0.00 0.001">
      <geom name="target_geom" type="cylinder" size="0.025 0.0015"
            rgba="0.2 0.85 0.2 0.6"
            contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
